# Copiar este archivo como .env y completar con los datos reales
# NUNCA commitear el archivo .env al repositorio

EDENOR_EMAIL=tu@email.com
EDENOR_PASSWORD=tu_password

METROGAS_EMAIL=tu@email.com
METROGAS_PASSWORD=tu_password

EDESUR_EMAIL=tu@email.com
EDESUR_PASSWORD=tu_password

TELECENTRO_EMAIL=tu@email.com
TELECENTRO_PASSWORD=tu_password
# TELECENTRO_BROWSER_USER_DATA_DIR=  # Opcional: ruta del clon del perfil Chrome

CLARO_EMAIL=tu@email.com
CLARO_PASSWORD=tu_password

VISA_DOCUMENTO_NACIONAL_DE_IDENTIDAD=tu_dni
VISA_USUARIO=tu_usuario_visa
VISA_PASSWORD=tu_password
VISA_TITULAR=Nombre Apellido

MASTERCARD_EMAIL=tu@email.com
MASTERCARD_PASSWORD=tu_password

# --- Google Drive ---
# ID de la carpeta raíz en Drive (ej. "Comprob.Electronicos")
# Lo encontrás en la URL de la carpeta: drive.google.com/drive/folders/ESTE_ID
GOOGLE_DRIVE_FOLDER_ID=

# JSON de la Service Account (pegar el contenido completo del archivo .json)
# O bien la ruta al archivo: /ruta/al/service_account.json
GOOGLE_SERVICE_ACCOUNT_JSON=

# Nombre del banco para las tarjetas de crédito (aparece en el nombre del archivo)
VISA_BANCO=Galicia
MASTERCARD_BANCO=Galicia
