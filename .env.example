# Copiar este archivo como .env para configuración no secreta.
# Las credenciales se gestionan cifradas en SQLite con:
# python main.py --gestionar-credenciales

# TELECENTRO_BROWSER_USER_DATA_DIR=  # Opcional: ruta del clon del perfil Chrome Default

# Genera una clave Fernet y configúrala como variable de entorno del usuario:
# PROVIDERS_CREDENTIALS_KEY
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --- Google Drive ---
# ID de la carpeta raíz en Drive (ej. "Comprob.Electronicos")
# Lo encontrás en la URL de la carpeta: drive.google.com/drive/folders/ESTE_ID
GOOGLE_DRIVE_FOLDER_ID=

# JSON de la Service Account (pegar el contenido completo del archivo .json)
# O bien la ruta al archivo: /ruta/al/service_account.json
GOOGLE_SERVICE_ACCOUNT_JSON=

# Nombre del banco para las tarjetas de crédito (aparece en el nombre del archivo)
VISA_BANCO=Galicia
MASTERCARD_BANCO=Galicia

# --- Airtable (sincronizacion opcional de comprobantes) ---
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
# Nombres exactos de las tablas; vacios usan estos valores por defecto.
AIRTABLE_COMPROBANTES_TABLE=Comprobantes
AIRTABLE_CONCEPTOS_TABLE=Conceptos
# Campos en las tablas existentes Comprobantes y Conceptos.
AIRTABLE_CONCEPTO_NOMBRE_FIELD=Nombre
AIRTABLE_CONCEPTO_FIELD=Concepto
AIRTABLE_DOCUMENTO_FIELD=Doc.
AIRTABLE_VENCIMIENTO_FIELD=Fecha Vto.
AIRTABLE_PROXIMO_VENCIMIENTO_FIELD=Prox.Vto.
AIRTABLE_CIERRE_FIELD=Cierre Actual
AIRTABLE_PROXIMO_CIERRE_FIELD=Prox.Cierre
AIRTABLE_IMPORTE_PESOS_FIELD=Importe Pesos
AIRTABLE_IMPORTE_DOLARES_FIELD=Importe USD
